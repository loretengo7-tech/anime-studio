{
  "name": "animestudio-desktop",
  "productName": "AnimeStudio",
  "version": "0.23.0",
  "description": "AnimeStudio \u2014 After Effects-style anime video editor (desktop build)",
  "author": "Luis Caballero",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "online.animestudio.desktop",
    "productName": "AnimeStudio",
    "files": [
      "main.cjs",
      "preload.cjs",
      "ofx.cjs",
      "icon.png",
      "app/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "AnimeStudio-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "AnimeStudio-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AnimeStudio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AnimeStudio-${version}-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video"
    },
    "extraResources": [
      {
        "from": "ai",
        "to": "ai",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ofxhost/build",
        "to": "ofx",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
